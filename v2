// =====================================================
// DESKTOP INPUT
// =====================================================

void desktopInput() {

  // =========================================
  // Вгору
  // =========================================

  if (joystickUp()) {

    if (selectedApp > 0) {

      selectedApp--;

      // Якщо вибір вийшов вище видимої області
      if (selectedApp < firstApp) {
        firstApp--;
      }

      drawDesktop();
    }

    return;
  }


  // =========================================
  // Вниз
  // =========================================

  if (joystickDown()) {

    if (selectedApp < appCount - 1) {

      selectedApp++;

      // Якщо вибір вийшов нижче видимої області
      if (selectedApp >= firstApp + strings) {
        firstApp++;
      }

      drawDesktop();
    }

    return;
  }


  // =========================================
  // Натискання
  // =========================================

  if (joystickPressed()) {

    switch (selectedApp) {

      case 0:

        currentScreen = FILE_MANAGER;
        drawFileManager();

        break;


      case 1:

        currentScreen = TEXT_EDITOR;
        drawTextEditor();

        break;


      case 2:

        currentScreen = CALCULATOR;
        drawCalculator();

        break;


      case 3:

        currentScreen = SETTINGS;
        drawSettings();

        break;


      case 4:

        currentScreen = GAMES;
        drawGames();

        break;


      case 5:

        currentScreen = NETWORK;
        drawNetwork();

        break;


      case 6:

        currentScreen = TERMINAL;
        drawTerminal();

        break;


      case 7:

        currentScreen = PAINT;
        drawPaint();

        break;


      case 8:

        currentScreen = MUSIC;
        drawMusic();

        break;


      case 9:

        currentScreen = CLOCK;
        drawClock();

        break;


      case 10:

        currentScreen = SYSTEM_INFO;
        drawSystemInfo();

        break;
    }

    return;
  }
}
// =====================================================
// FILE MANAGER
// =====================================================

void drawFileManager() {
  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.println("FILE MANAGER");

  display.drawLine(0, 9, 127, 9, SSD1306_WHITE);

  File root = LittleFS.open("/");
  File file = root.openNextFile();

  int fileIndex = 0;
  int drawnFiles = 0;

  while (file && drawnFiles < visibleFiles) {
    if (!file.isDirectory()) {
      String fileName = file.name();

      // Пропускаємо файли перед вибраним елементом
      if (fileIndex >= selectedFile) {
        display.setCursor(0, 13 + drawnFiles * 9);

        if (fileIndex == selectedFile) {
          display.print(">");
        } else {
          display.print(" ");
        }

        // Виводимо максимум 19 символів назви
        if (fileName.length() > 19) {
          fileName = fileName.substring(0, 19);
        }

        display.println(fileName);
        drawnFiles++;
      }

      fileIndex++;
    }

    file = root.openNextFile();
  }

  if (fileIndex == 0) {
    display.setCursor(0, 20);
    display.println("No files");
  }

  display.setCursor(0, 56);
  display.println("Hold = Back");

  display.display();
}

void fileManagerInput() {
  int fileCount = getFileCount();

  if (joystickLongPressed()) {
    currentScreen = DESKTOP;
    selectedFile = 0;
    drawDesktop();
    return;
  }

  if (fileCount == 0) {
    return;
  }

  if (joystickDown()) {
    if (selectedFile < fileCount - 1) {
      selectedFile++;
      drawFileManager();
    }

    return;
  }

  if (joystickUp()) {
    if (selectedFile > 0) {
      selectedFile--;
      drawFileManager();
    }

    return;
  }

  if (joystickPressed()) {
    openSelectedFile();
    return;
  }
}

