// =====================================================
// JOYSTICK — BEEP
// =====================================================

void joystickBeep() {
  tone(BUZZER_PIN, 2000, 50);
}


// =====================================================
// JOYSTICK — DOWN
// =====================================================

bool joystickDown() {

  int y = analogRead(JOY_Y);

  if (y < JOY_CENTER - JOY_DEADZONE) {

    if (!joystickYMoved) {

      joystickYMoved = true;

      joystickBeep();

      return true;
    }
  }

  // Джойстик повернувся в центр
  if (
    y >= JOY_CENTER - JOY_DEADZONE &&
    y <= JOY_CENTER + JOY_DEADZONE
  ) {

    joystickYMoved = false;
  }

  return false;
}


// =====================================================
// JOYSTICK — UP
// =====================================================

bool joystickUp() {

  int y = analogRead(JOY_Y);

  if (y > JOY_CENTER + JOY_DEADZONE) {

    if (!joystickYMoved) {

      joystickYMoved = true;

      joystickBeep();

      return true;
    }
  }

  // Джойстик повернувся в центр
  if (
    y >= JOY_CENTER - JOY_DEADZONE &&
    y <= JOY_CENTER + JOY_DEADZONE
  ) {

    joystickYMoved = false;
  }

  return false;
}


// =====================================================
// JOYSTICK — RIGHT
// =====================================================

bool joystickRight() {

  int x = analogRead(JOY_X);

  if (x < JOY_CENTER - JOY_DEADZONE) {

    if (!joystickXMoved) {

      joystickXMoved = true;

      joystickBeep();

      return true;
