// =====================================================
// SETUP
// =====================================================

void setup() {

  // -------------------------
  // Serial
  // -------------------------

  Serial.begin(115200);

  // -------------------------
  // I2C
  // -------------------------

  Wire.begin(
    I2C_SDA,
    I2C_SCL
  );

  // -------------------------
  // Бузер
  // -------------------------

  pinMode(
    BUZZER_PIN,
    OUTPUT
  );

  digitalWrite(
    BUZZER_PIN,
    LOW
  );

  // -------------------------
  // Джойстик
  // -------------------------

  pinMode(
    JOY_X,
    INPUT
  );

  pinMode(
    JOY_Y,
    INPUT
  );

  pinMode(
    JOY_SW,
    INPUT_PULLUP
  );

  // -------------------------
  // OLED
  // -------------------------

  if (
    !display.begin(
      SSD1306_SWITCHCAPVCC,
      0x3C
    )
  ) {

    Serial.println(
      F("Помилка ініціалізації OLED!")
    );

    while (true);
  }

  // -------------------------
  // Network
  // -------------------------

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("======================");
  Serial.println("ESP32 WiFi TEST");
  Serial.println("======================");

  WiFi.mode(WIFI_STA);

  Serial.print("MAC: ");
  Serial.println(WiFi.macAddress());

  Serial.print("Connecting to: ");
  Serial.println(WIFI_SSID);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 30) {

    delay(500);

    Serial.print(".");
    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("======================");
    Serial.println("CONNECTED!");
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
    Serial.print("RSSI: ");
    Serial.println(WiFi.RSSI());
    Serial.println("======================");

  } else {

    Serial.println("======================");
    Serial.println("CONNECTION FAILED");
    Serial.print("WiFi status: ");
    Serial.println(WiFi.status());
    Serial.println("======================");
  }

  // -------------------------
  // Boot
  // -------------------------

  showBootScreen();

  // -------------------------
  // Початковий стан
  // -------------------------

  currentScreen = DESKTOP;

  selectedApp = 0;

  drawDesktop();
}

