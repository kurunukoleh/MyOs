}

// =====================================================
// JOYSTICK — BUTTON
// =====================================================

bool joystickPressed() {

  bool pressed =
    digitalRead(JOY_SW) == LOW;

  if (
    pressed &&
    !joystickButtonWasPressed
  ) {

    joystickButtonWasPressed = true;

    return true;
  }

  if (!pressed) {

    joystickButtonWasPressed = false;
  }

  return false;
}

// =====================================================
// JOYSTICK — LONG PRESS
// =====================================================

bool joystickLongPressed() {

  static unsigned long pressStart = 0;
  static bool longPressTriggered = false;

  bool pressed = digitalRead(JOY_SW) == LOW;

  if (pressed) {

    if (pressStart == 0) {
      pressStart = millis();
      longPressTriggered = false;
    }

    if (
      !longPressTriggered &&
      millis() - pressStart >= 1000
    ) {

      longPressTriggered = true;

      joystickBeep();

      return true;
    }
  }

  else {

    pressStart = 0;
    longPressTriggered = false;
  }

  return false;
}

void drawVirtualKeyboard() {

  // Звичайні символи
  for (int row = 0; row < keyboardRows; row++) {

    display.setCursor(0, 22 + row * 7);

    for (int col = 0; col < keyboardCols; col++) {

      char key = keyboard[row][col];

      if (row == keyboardRow && col == keyboardCol) {
        display.print("[");
        display.print(key);
        display.print("]");
      } else {
        display.print(" ");
        display.print(key);
        display.print(" ");
      }
    }
  }

  // Функціональний ряд
  display.setCursor(0, 52);

  if (keyboardRow == keyboardRows) {

    if (keyboardCol == 0) {
      display.print("[BACK] ");
      display.print(" OK");
    } 
    else {
      display.print(" BACK ");
      display.print("[OK]");
    }

  } else {

    display.print(" BACK   OK");
  }
}

void handleVirtualKeyboard() {

  // Вправо
  if (joystickRight()) {

    if (keyboardCol < keyboardCols - 1) {
      keyboardCol++;
    }

    drawTextEditor();
    return;
  }

  // Вліво
  if (joystickLeft()) {

    if (keyboardCol > 0) {
      keyboardCol--;
    }

    drawTextEditor();
    return;
  }

  // Вниз
  if (joystickDown()) {

    if (keyboardRow < keyboardRows) {
      keyboardRow++;
    }

    drawTextEditor();
    return;
  }

  // Вгору
  if (joystickUp()) {

    if (keyboardRow > 0) {
      keyboardRow--;
    }

    drawTextEditor();
    return;
  }

  // Натискання
  if (joystickPressed()) {

    // =========================
    // ФУНКЦІОНАЛЬНИЙ РЯД
    // =========================

    if (keyboardRow == keyboardRows) {

      // BACK
      if (keyboardCol == 0) {

        // Видалити останній символ
        if (editorText.length() > 0) {
          editorText.remove(editorText.length() - 1);
        }

      }

      // OK
      else if (keyboardCol == 1) {

        // Тут буде дія OK
        // Наприклад, відкрити вікно збереження

        currentScreen = SAVE_FILE;
        drawSaveFile();

        return;
      }

      drawTextEditor();
      return;
    }


    // =========================
    // ЗВИЧАЙНИЙ СИМВОЛ
    // =========================

    if (keyboardRow >= 0 &&
        keyboardRow < keyboardRows &&
        keyboardCol >= 0 &&
        keyboardCol < keyboardCols) {

      editorText += keyboard[keyboardRow][keyboardCol];
    }

    drawTextEditor();
    return;
  }
}

void drawDigitsKeyboard() {

  for (int row = 0; row < keyboardRowsDigits; row++) {

    display.setCursor(0, 22 + row * 8);

    for (int col = 0; col < keyboardColsDigits; col++) {

      char key = keyboardDigits[row][col];

      if (row == keyboardRowDigits &&
          col == keyboardColDigits) {

        display.print("[");
        display.print(key);
        display.print("]");

      } else {

        display.print(" ");
        display.print(key);
        display.print(" ");
      }
    }
  }
}

void handleDigitsKeyboard() {

  // Вправо
  if (joystickRight()) {

    if (keyboardColDigits < keyboardColsDigits - 1) {
      keyboardColDigits++;
    }

    drawCalculator();
    return;
  }

  // Вліво
  if (joystickLeft()) {

    if (keyboardColDigits > 0) {
      keyboardColDigits--;
    }

    drawCalculator();
    return;
  }

  // Вниз
  if (joystickDown()) {

    if (keyboardRowDigits < keyboardRowsDigits - 1) {
      keyboardRowDigits++;
    }

    drawCalculator();
    return;
  }

  // Вгору
  if (joystickUp()) {

    if (keyboardRowDigits > 0) {
      keyboardRowDigits--;
    }

    drawCalculator();
    return;
  }

  // Вибір символу
  if (joystickPressed()) {

    if (keyboardRowDigits >= 0 &&
        keyboardRowDigits < keyboardRowsDigits &&
        keyboardColDigits >= 0 &&
        keyboardColDigits < keyboardColsDigits) {

      editorText += keyboardDigits[
        keyboardRowDigits
      ][
        keyboardColDigits
      ];
    }

    drawCalculator();
    return;
  }
}

