void saveFileInput() {

  // Довге натискання — скасування
  if (joystickLongPressed()) {

    currentScreen = saveFileFromTerminal
                    ? TERMINAL
                    : TEXT_EDITOR;

    if (saveFileFromTerminal) {
      drawTerminal();
    } else {
      drawTextEditor();
    }

    return;
  }

  // Переміщення вправо
  if (joystickRight()) {

    if (keyboardCol < keyboardCols - 1) {
      keyboardCol++;
    }

    drawSaveFile();
    return;
  }

  // Переміщення вліво
  if (joystickLeft()) {

    if (keyboardCol > 0) {
      keyboardCol--;
    }

    drawSaveFile();
    return;
  }

  // Переміщення вниз
  if (joystickDown()) {

    if (keyboardRow < keyboardRows - 1) {
      keyboardRow++;
    }

    drawSaveFile();
    return;
  }

  // Переміщення вгору
  if (joystickUp()) {

    if (keyboardRow > 0) {
      keyboardRow--;
    }

    drawSaveFile();
    return;
  }

  // Вибір символу
  if (joystickPressed()) {

    char key = keyboard[keyboardRow][keyboardCol];

    saveFileName += key;

    drawSaveFile();
    return;
  }
}

void saveCurrentFile() {

  if (saveFileName.length() == 0) {
    return;
  }

  String path = "/" + saveFileName + ".txt";

  File file = LittleFS.open(path, "w");

  if (!file) {
    return;
  }

  file.print(editorText);
  file.close();

  currentScreen = FILE_MANAGER;
  drawFileManager();
}

int getFileCount() {
  int count = 0;

  File root = LittleFS.open("/");
  File file = root.openNextFile();

  while (file) {
    if (!file.isDirectory()) {
      count++;
    }

    file = root.openNextFile();
  }

  return count;
}

void openSelectedFile() {
  File root = LittleFS.open("/");
  File file = root.openNextFile();

  int fileIndex = 0;

  while (file) {
    if (!file.isDirectory()) {
      if (fileIndex == selectedFile) {
        String content = file.readString();

        Serial.println("Opening file:");
        Serial.println(file.name());
        Serial.println(content);

        // Поки що показуємо вміст у редакторі
        editorText = content;
        currentScreen = TEXT_EDITOR;
        drawTextEditor();

        return;
      }

      fileIndex++;
    }

    file = root.openNextFile();
  }
}


